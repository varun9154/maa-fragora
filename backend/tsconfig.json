{
  "compilerOptions": {
    "target": "ES2022",

    "module": "Node16",
    "moduleResolution": "node16",

    "rootDir": "./src",
    "outDir": "./dist",

    "strict": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "resolveJsonModule": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "sourceMap": true,

    "types": ["node"],

    "noImplicitAny": true,

    "noUnusedLocals": false,

    "noUnusedParameters": false
  },

  "include": ["src"],

  "exclude": [
    "node_modules",
    "dist"
  ]
}